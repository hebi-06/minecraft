{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "rpg:svalinn_hex",
      "basic_render_parameters": {
        "material": "particles_blend",
        "texture": "textures/particle/rpg/fx/svalinn_hex"
      }
    },
    "components": {
      "minecraft:emitter_rate_instant": {
        "num_particles": 1
      },
      "minecraft:emitter_lifetime_once": {},
      "minecraft:emitter_shape_point": {},
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "variable.life"
      },
      "minecraft:particle_motion_parametric": {
        "relative_position": [
          "variable.dir.x * variable.reach * math.clamp((variable.particle_age - variable.fold) / 0.4, 0, 1) * math.clamp((variable.particle_age - variable.fold) / 0.4, 0, 1)",
          "variable.dir.y * variable.reach * math.clamp((variable.particle_age - variable.fold) / 0.4, 0, 1) * math.clamp((variable.particle_age - variable.fold) / 0.4, 0, 1)",
          "variable.dir.z * variable.reach * math.clamp((variable.particle_age - variable.fold) / 0.4, 0, 1) * math.clamp((variable.particle_age - variable.fold) / 0.4, 0, 1)"
        ]
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "variable.size * (1 - 0.7 * math.clamp((variable.particle_age - variable.fold) / 0.4, 0, 1))",
          "variable.size * (1 - 0.7 * math.clamp((variable.particle_age - variable.fold) / 0.4, 0, 1))"
        ],
        "facing_camera_mode": "lookat_xyz",
        "uv": {
          "texture_width": 128,
          "texture_height": 64,
          "uv": [
            "variable.frame * 64",
            0
          ],
          "uv_size": [
            64,
            64
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          "variable.color.r",
          "variable.color.g",
          "variable.color.b",
          "math.min(1, variable.color.a * math.clamp(variable.particle_age / 0.15, 0, 1) * (1 + 0.8 * math.clamp((variable.particle_age - variable.fold) / 0.4, 0, 1)))"
        ]
      }
    }
  }
}
