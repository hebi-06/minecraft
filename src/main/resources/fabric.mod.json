{
  "schemaVersion": 1,
  "id": "mmorpg",
  "version": "${version}",
  "name": "MMO RPG",
  "description": "베드락 애드온 \"MMO RPG 시스템\" 의 자바 에디션 이식: 스탯 (힘 · 민첩 · 마력 · 체력) · 레벨 포인트 · RPG 체력 · 무기 151종 (요구 스탯 · 피해 공식 · 활 · 완드) · 피해 숫자",
  "license": "All-Rights-Reserved",
  "icon": "assets/mmorpg/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "mmorpg.fabric.Mmorpg"
    ],
    "client": [
      "mmorpg.fabric.client.MmorpgClient"
    ]
  },
  "mixins": [
    "mmorpg.mixins.json",
    {
      "config": "mmorpg.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=0.19.5",
    "minecraft": "~26.3",
    "java": ">=25",
    "fabric-api": ">=0.162.0"
  }
}