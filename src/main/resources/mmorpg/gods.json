{"_":"원소신 NPC (tools/god_npcs.py 가 만듦 — 고치려면 그 파일을)","gods":{"laeta":{"name":"라에타","title":"번개 · 풍요의 신","greeting":"왔구나! 마침 잘 왔어. 올해도 넘치게 여물었거든.|자, 이것도 받고, 저것도 받아.||…칭찬은 천천히 해도 돼. 아주 천천히.","skin":"rpg:entity/god/laeta","slim":true,"cape":null,"head":"rpg:god/laeta_head","main":"rpg:god/laeta_bachi","off":"rpg:god/laeta_masu","props":[{"model":"rpg:god/laeta_ring","k":1.0,"ops":[["t",0,21,6.5],["spin","z",0.8,0]]},{"model":"rpg:god/laeta_drum","k":1.0,"ops":[["t",0,21,6.5],["spin","z",0.8,0],["r","z",0],["t",0,12,0]]},{"model":"rpg:god/laeta_drum","k":1.0,"ops":[["t",0,21,6.5],["spin","z",0.8,0],["r","z",45],["t",0,12,0]]},{"model":"rpg:god/laeta_drum","k":1.0,"ops":[["t",0,21,6.5],["spin","z",0.8,0],["r","z",90],["t",0,12,0]]},{"model":"rpg:god/laeta_drum","k":1.0,"ops":[["t",0,21,6.5],["spin","z",0.8,0],["r","z",135],["t",0,12,0]]},{"model":"rpg:god/laeta_drum","k":1.0,"ops":[["t",0,21,6.5],["spin","z",0.8,0],["r","z",180],["t",0,12,0]]},{"model":"rpg:god/laeta_drum","k":1.0,"ops":[["t",0,21,6.5],["spin","z",0.8,0],["r","z",225],["t",0,12,0]]},{"model":"rpg:god/laeta_drum","k":1.0,"ops":[["t",0,21,6.5],["spin","z",0.8,0],["r","z",270],["t",0,12,0]]},{"model":"rpg:god/laeta_drum","k":1.0,"ops":[["t",0,21,6.5],["spin","z",0.8,0],["r","z",315],["t",0,12,0]]}],"particles":[{"kind":"dust","color":"#FFE14D","size":0.8,"every":3,"count":1,"at":[0,21,6.5],"spread":[11,11,1]},{"kind":"spark","every":9,"count":2,"at":[6,25,-4],"spread":[1.5,3,1.5]},{"kind":"dust","color":"#FFF6D2","size":0.6,"every":5,"count":1,"at":[-6,13,-5],"spread":[1.5,0.5,1.5]}]},"nivaria":{"name":"니바리아","title":"얼음 여왕","greeting":"어서 와요. 발밑 조심해요. 그건 300년 된 재채기예요.||그 질문은 얼려서 보관해 둘게요.|나중에, 아주 나중에 꺼내 줄게요.","skin":"rpg:entity/god/nivaria","slim":true,"cape":"rpg:entity/god/nivaria_cape","head":"rpg:god/nivaria_head","main":null,"off":"rpg:god/nivaria_staff","props":[{"model":"rpg:god/nivaria_keep_candle","k":1.0,"ops":[["t",0,15,0],["spin","y",0.55,0],["t",13,0,0],["bob",0.9,0.07,0.0],["spin","y",-1.1,0]]